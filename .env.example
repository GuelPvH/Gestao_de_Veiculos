APP_NAME="Frota · PF"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Enabled only when APP_ENV=local and APP_DEBUG=true.
DEBUGBAR_ENABLED=true
APP_URL=http://127.0.0.1:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_URL=
DB_HOST=configure_privadamente
DB_PORT=3306
DB_DATABASE=configure_privadamente
DB_USERNAME=configure_privadamente
DB_PASSWORD=configure_privadamente
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=configure_privadamente
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=configure_privadamente
MAIL_FROM_NAME="Frota · PF"
FLEET_REVIEW_ENABLED=false
FLEET_RECOVERY_MAIL_ENABLED=false
FLEET_RECOVERY_QUEUE_ENABLED=false
FLEET_RECOVERY_QUEUE_CONNECTION=database
FLEET_SESSION_MAX_LIFETIME_MINUTES=720
FLEET_PRIVATE_DIR=../frota-private
# Alvo remoto autorizado para manutenção; configure no ambiente privado.
FLEET_REMOTE_DB_DATABASE=

# A fila MySQL deve aguardar mais que o timeout de 60s dos workers.
DB_QUEUE_RETRY_AFTER=120
MAIL_TIMEOUT=15
FLEET_TRUSTED_PROXIES=
FLEET_SESSION_REAUTHENTICATION_MINUTES=30
# MFA stays required outside local development, regardless of this switch.
FLEET_MFA_ENABLED=true
# To pause locally with compose.local.yml: FLEET_LOCAL_MFA_ENABLED=false.
# Exact HTTPS origin and hostname for WebAuthn; configure before admin access.
FLEET_MFA_ORIGIN=
FLEET_MFA_RP_ID=
# Keep deliveries disabled until local and provider acceptance tests pass.
FLEET_ACTIVATION_MAIL_ENABLED=false
FLEET_VERIFICATION_MAIL_ENABLED=false
FLEET_SECURITY_MAIL_ENABLED=false
FLEET_TEMPORARY_PASSWORD_HOURS=24
FLEET_ACTIVATION_HOURS=24
FLEET_VERIFICATION_MINUTES=60

# Aggregate operational alerts; consumed by fleet:delivery-health.
FLEET_DELIVERY_PENDING_MAX=100
FLEET_DELIVERY_OLDEST_SECONDS=600
FLEET_DELIVERY_EXPIRED_LEASES_MAX=0
FLEET_DELIVERY_FINAL_FAILURES_MAX=0
FLEET_DELIVERY_HEARTBEAT_SECONDS=90
FLEET_DELIVERY_ALERT_TTL_SECONDS=900
