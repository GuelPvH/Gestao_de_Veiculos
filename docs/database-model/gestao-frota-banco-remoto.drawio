          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="1160" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-11" label="Um único conector representa toda a constraint. Os pares de colunas são preservados no tooltip e no catálogo, na ordem original.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
