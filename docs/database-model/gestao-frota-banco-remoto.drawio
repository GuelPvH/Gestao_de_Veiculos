        </object>
        <object id="lg-title-2" label="Pé de galinha: 0..N">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="368" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-2" label="Um registro pai pode possuir zero ou muitos filhos. A FK, isoladamente, não exige a existência de filhos.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="368" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-3" label="Barra dupla: 1">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="456" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-3" label="Uma referência preenchida identifica exatamente um pai, desde que o conjunto referenciado seja único.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="456" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-4" label="Círculo e barra: 0..1">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="544" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-4" label="Referência opcional, ou no máximo um filho por pai quando as colunas da FK têm unicidade efetiva.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="544" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-5" label="Traço contínuo">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="632" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-5" label="FK identificadora: todas as suas colunas participam da chave primária da tabela filha.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="632" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-6" label="Traço descontínuo">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="720" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-6" label="FK física não identificadora. Este estilo não significa relação inferida ou ausência de constraint.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="720" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-7" label="R001, R002, …">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="808" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-7" label="Identificador estável no catálogo de relacionamentos. Passe o cursor para consultar o nome da FK, colunas e regras ON DELETE/ON UPDATE.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="808" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-8" label="Cartão REFERÊNCIA">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="896" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-8" label="Recorte de uma tabela definida em outra posição/página. Exibe as colunas alvo das FKs e mantém navegação para o domínio responsável.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="496" y="896" width="1040" height="72" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-title-9" label="Fundo verde suave">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#173A64;spacing=0;" vertex="1" parent="1" connectable="0">
            <mxGeometry x="64" y="984" width="400" height="56" as="geometry" />
          </mxCell>
        </object>
        <object id="lg-body-9" label="LONGTEXT associado à validação JSON_VALID no MariaDB; o tipo físico foi preservado e o alias JSON está documentado.">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#33455E;spacing=0;" vertex="1" parent="1" connectable="0">
